      "path": "/Users/REDACTED/workspace/geode/.claude/worktrees/bench-v1.0.9/artifacts/eval/harnesses/mcpmark/.mcpmark_backups/backup_filesystem_legal_document_file_reorganize_49546/legal_files/Preferred_Stock_Purchase_Agreement_v8.txt",
